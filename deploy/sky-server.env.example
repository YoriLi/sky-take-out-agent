# =============================================================================
# 后端环境变量模板（复制为 sky-server.env 后填充真实值；请勿提交到 Git）
#
# 这些是「应用密钥」，必须注入到后端 JVM 进程的环境变量里，而不是 Nginx。
# 使用方式（三选一，见 README 第 4 节）：
#   - systemd：EnvironmentFile=/etc/sky-take-out/sky-server.env
#   - Docker ：docker run --env-file sky-server.env ...
#   - 裸机脚本：set -a; source sky-server.env; set +a; java -jar sky-server.jar
#
# 变量名与 application.yml / application-dev.yml 中的 ${...} 占位符一一对应。
# =============================================================================

# ---- 数据库（MySQL）----
SKY_DB_HOST=127.0.0.1
SKY_DB_PORT=3306
SKY_DB_NAME=sky_take_out
SKY_DB_USERNAME=root
SKY_DB_PASSWORD=            # TODO: 数据库口令

# ---- Redis ----
SKY_REDIS_HOST=127.0.0.1
SKY_REDIS_PORT=6379
SKY_REDIS_PASSWORD=         # TODO: 无密码可留空
SKY_REDIS_DATABASE=10

# ---- JWT（务必改成足够长的随机串，勿用默认值）----
# 生成示例：openssl rand -base64 48
SKY_JWT_ADMIN_SECRET=       # TODO: 管理端签名密钥（≥32 字节随机）
SKY_JWT_ADMIN_TTL=7200000
SKY_JWT_USER_SECRET=        # TODO: 用户端签名密钥（≥32 字节随机）
SKY_JWT_USER_TTL=7200000

# ---- AI 助手（DeepSeek / OpenAI 兼容）----
SKY_AGENT_API_KEY=          # TODO: 留空则后端仍可启动，走本地二次确认兜底
SKY_AGENT_BASE_URL=https://api.deepseek.com
SKY_AGENT_MODEL=deepseek-chat
SKY_AGENT_TIMEOUT=120
SKY_AGENT_MEMORY_MAX=20
SKY_AGENT_RATE_LIMIT=20

# ---- 门店/地图/上传 ----
SKY_SHOP_ADDRESS=湖北省武汉市洪山区徐东大街18号
SKY_BAIDU_AK=               # TODO: 留空则跳过配送范围校验（单店可先不填）
SKY_UPLOAD_MAX_SIZE=5242880

# ---- 阿里云 OSS（图片上传）----
SKY_ALIOSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
SKY_ALIOSS_ACCESS_KEY_ID=       # TODO
SKY_ALIOSS_ACCESS_KEY_SECRET=   # TODO
SKY_ALIOSS_BUCKET=sky-take-out

# ---- 微信小程序 / 微信支付（无 C 端支付可暂时留空）----
SKY_WECHAT_APPID=
SKY_WECHAT_SECRET=
SKY_WECHAT_MCHID=
SKY_WECHAT_MCH_SERIAL_NO=
SKY_WECHAT_PRIVATE_KEY_PATH=
SKY_WECHAT_API_V3_KEY=
SKY_WECHAT_CERT_PATH=
SKY_WECHAT_NOTIFY_URL=
SKY_WECHAT_REFUND_NOTIFY_URL=
