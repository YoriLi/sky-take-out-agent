# Copy to application-dev.yml and fill in real values.
# Prefer environment variables over hardcoding secrets.
sky:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: ${SKY_DB_HOST:localhost}
    port: ${SKY_DB_PORT:3306}
    database: ${SKY_DB_NAME:sky_take_out}
    username: ${SKY_DB_USERNAME:root}
    password: ${SKY_DB_PASSWORD:123456}
  alioss:
    endpoint: ${SKY_ALIOSS_ENDPOINT:oss-cn-hangzhou.aliyuncs.com}
    access-key-id: ${SKY_ALIOSS_ACCESS_KEY_ID:}
    access-key-secret: ${SKY_ALIOSS_ACCESS_KEY_SECRET:}
    bucket-name: ${SKY_ALIOSS_BUCKET:sky-take-out}
  redis:
    host: ${SKY_REDIS_HOST:localhost}
    port: ${SKY_REDIS_PORT:6379}
    password: ${SKY_REDIS_PASSWORD:}
    database: ${SKY_REDIS_DATABASE:10}
  wechat:
    appid: ${SKY_WECHAT_APPID:}
    secret: ${SKY_WECHAT_SECRET:}
    mchid: ${SKY_WECHAT_MCHID:}
    mchSerialNo: ${SKY_WECHAT_MCH_SERIAL_NO:}
    privateKeyFilePath: ${SKY_WECHAT_PRIVATE_KEY_PATH:}
    apiV3Key: ${SKY_WECHAT_API_V3_KEY:}
    weChatPayCertFilePath: ${SKY_WECHAT_CERT_PATH:}
    notifyUrl: ${SKY_WECHAT_NOTIFY_URL:}
    refundNotifyUrl: ${SKY_WECHAT_REFUND_NOTIFY_URL:}
